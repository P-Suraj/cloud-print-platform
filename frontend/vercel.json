{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://autoprint-api.vercel.app/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://autoprint-api.vercel.app/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
