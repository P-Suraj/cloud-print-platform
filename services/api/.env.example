# AutoPrint v3 API Environment Configuration
PORT=8000
ENVIRONMENT=development
CONTRACT_VERSION=3

# Database Connection String for autoprint_v3
DATABASE_URL=postgresql://postgres:postgres@localhost:54321/postgres
CANARY_OWNER_EMAIL=verified-owner@example.com

# Supabase credentials. service_role is migration/operator-only; runtime API
# and worker traffic must use JWTs whose role claims are the roles below.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_API_ROLE_KEY=your-signed-jwt-with-role-autoprint_api_role
SUPABASE_WORKER_ROLE_KEY=your-signed-jwt-with-role-autoprint_worker_role
SUPABASE_ANON_KEY=your-anon-key

# Storage Bucket
STORAGE_BUCKET=print-jobs
QUEUE_ESTIMATES_ENABLED=false

# Security Secrets
COOKIE_SECRET=change-this-to-a-secure-random-secret-in-production

# Allowed CORS Origins (JSON array or comma-separated string)
CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
